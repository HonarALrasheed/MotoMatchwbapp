# ── Supabase ─────────────────────────────────────────────────────────
# Erstelle ein Projekt unter https://supabase.com und trage hier ein:
VITE_SUPABASE_URL=https://DEIN-PROJEKT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=dein-anon-public-key

# ── Serverless API Keys (nur serverseitig, in Vercel als Environment Variable setzen) ──
# Diese Keys werden NICHT ins Client-Bundle eingebettet. Niemals VITE_-Prefix verwenden.
TAVILY_KEY=dein-tavily-key

# ── Partnerprogramme (Ausrüstungs-Reiter) ────────────────────────────
# Alles optional. Ohne Eintrag bleiben die Produktlinks normale Links — die
# Seite läuft unverändert, nur ohne Provision. Sobald hier etwas steht,
# blendet die Ausrüstung automatisch den Kennzeichnungshinweis ein.
# VITE_-Präfix ist Absicht: die Kennungen stehen ohnehin sichtbar in jedem
# erzeugten Link.
#
# Jeder Shop läuft über ein anderes Netzwerk — einzeln freischaltbar.
#
# Amazon PartnerNet (7 Produkte) — partnernet.amazon.de
#   Die Tracking-ID aus deinem Konto, endet auf .de üblicherweise auf "-21".
VITE_AMAZON_TAG=
#
# Louis über belboon (23 Produkte) — belboon.com
#   Hier die KOMPLETTE Basis-Trackingadresse aus dem belboon-Konto einsetzen,
#   z. B. https://www1.belboon.de/tracking/000000123.html
#   Das Produktziel hängt die App selbst als deeplink= an.
VITE_BELBOON_LOUIS_BASE=
#
# FC-Moto über Webgains (34 Produkte) — webgains.com
#   Zwei Nummern aus dem Webgains-Konto:
#   wgcampaignid = deine Publisher-Kampagne (für alle Programme gleich)
#   wgprogramid  = das Programm FC-Moto DE
VITE_WEBGAINS_CAMPAIGN_ID=
VITE_WEBGAINS_PROGRAM_FCMOTO=

# Pflicht: kommagetrennte Allowlist der Origins, die api/* aufrufen dürfen.
# Ohne Match antwortet der Endpoint mit 403. Kein Wildcard-Support.
ALLOWED_ORIGINS=https://moto-matchwbapp.vercel.app,http://localhost:5173

# ── Google Maps (Client-seitig) ───────────────────────────────────────
# In der Google Cloud Console per HTTP-Referrer + API-Restriktion absichern
VITE_GMAPS_KEY=dein-google-maps-key

# ── LiveKit (Sprachkanäle) ─────────────────────────────────────────────
# Kostenloses Projekt unter https://cloud.livekit.io anlegen.
# VITE_LIVEKIT_URL ist die Projekt-URL (wss://...), client-seitig sichtbar.
# LIVEKIT_API_KEY/_SECRET sind Server-Secrets — NIEMALS mit VITE_-Prefix,
# nur in api/livekit-token.js verwendet, dort wird das Verbindungs-Token
# clientseitig NIE selbst erzeugt.
VITE_LIVEKIT_URL=wss://dein-projekt.livekit.cloud
LIVEKIT_API_KEY=dein-livekit-api-key
LIVEKIT_API_SECRET=dein-livekit-api-secret

# ── Web Push (Desktop-Benachrichtigungen für DMs + Freundschaftsanfragen) ──
# VAPID-Keys selbst generieren: npx web-push generate-vapid-keys (kein Account
# nötig). VITE_VAPID_PUBLIC_KEY ist client-seitig sichtbar (das ist normal für
# den öffentlichen VAPID-Schlüssel), die anderen drei sind Server-Secrets.
VITE_VAPID_PUBLIC_KEY=dein-vapid-public-key
VAPID_PRIVATE_KEY=dein-vapid-private-key
VAPID_SUBJECT=mailto:deine@email.de
# Geteiltes Secret, das der Supabase Database Webhook als Header
# "x-webhook-secret" mitschicken muss (Dashboard → Database → Webhooks).
SUPABASE_WEBHOOK_SECRET=ein-zufaelliges-secret
# Project Settings → API → service_role — umgeht RLS komplett, mit Vorsicht
# behandeln, niemals mit VITE_-Prefix, niemals ins Client-Bundle.
# Gebraucht von api/push-trigger.js (Empfaenger nachschlagen) und
# api/delete-account.js (auth.admin.deleteUser + Storage aufraeumen). Fehlt der
# Key, antwortet delete-account mit 500/not_configured und loescht nichts.
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key

# ── Sentry (optional, für Fehler-Monitoring in der Beta) ──────────────
# Ohne DSN: no-op. Frontend nutzt VITE_SENTRY_DSN (client-bundled),
# Serverless-Functions nutzen SENTRY_DSN (nur server, KEIN VITE_-Prefix).
VITE_SENTRY_DSN=
SENTRY_DSN=
# Trennt Produktions- von Preview-Fehlern in Sentry. In Vercel je Umgebung
# setzen (production / preview) — sonst melden Preview-Deploys als "production",
# weil `vite build` immer im Modus "production" läuft. Lokal leer lassen.
VITE_SENTRY_ENVIRONMENT=
SENTRY_ENVIRONMENT=

# ── Sticker (KLIPY) ───────────────────────────────────────────────
# Echte Bild-Sticker im Community-Chat (Suche, Trending, Vorschlaege beim
# Tippen). Kostenloser Key: https://klipy.com/developers — Formular ausfuellen,
# Test-Key (100 Anfragen/Stunde) kommt sofort, Produktions-Key auf Anfrage.
#
# Nicht Tenor: Google hat die Tenor-API am 30.06.2026 abgeschaltet und seit
# 13.01.2026 keine neuen Keys mehr vergeben. KLIPY ist der Dienst, zu dem
# WhatsApp, Discord und Figma gewechselt sind.
#
# Client-seitig sichtbar (VITE_-Prefix) — das ist bei Sticker-APIs vorgesehen.
# Ohne Key faellt der Sticker-Picker auf die eingebauten Emoji-Sticker zurueck.
VITE_KLIPY_KEY=
